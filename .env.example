# =============================================================================
# Portal AACD - exemplo de variaveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# `.env` esta no .gitignore — NUNCA comite ele.
# =============================================================================

# --- Servidor ---
# PORT=3000
# HOST=0.0.0.0

# --- SQL Server (PowerBIPortal + Fonte no SERVER55\DW) ---
# Se nao definir, o codigo cai nos defaults hardcoded em server.js (so funciona
# de dentro da rede AACD).
# DB_USER=servicedw
# DB_PASS=...
# DB_SERVER=SERVER55
# DB_NAME=PowerBIPortal

# --- JWT ---
# Em prod, SEMPRE setar um secret forte (nao usar o fallback do codigo).
# JWT_SECRET=troque-isto-em-producao

# --- Microsoft Auth (MSAL) ---
# MICROSOFT_AUTH_CLIENT_ID=b97df545-f361-4a9b-913f-f6a4b957486c
# MICROSOFT_AUTH_TENANT_ID=1ebad822-ee55-4814-9f70-6defb1fb0694
# MICROSOFT_AUTH_ENABLED=true

# --- Direct Line (chatbot) ---
# DIRECT_LINE_SECRET=...

# =============================================================================
# Power BI Embedded - Service Principal "Microsof-Fabric-PowerBI"
# Usado pelo modulo pbiEmbed.js para gerar embed tokens (App Owns Data).
# =============================================================================
PBI_TENANT_ID=1ebad822-ee55-4814-9f70-6defb1fb0694
PBI_CLIENT_ID=4ed5b1d3-e9d6-44c2-bfbc-33edc6a18f37
# NAO COMITAR o secret real. Cole o valor apenas no .env local (ou no IIS em prod).
PBI_CLIENT_SECRET=
