# ==============================
# Banco de dados
# ==============================
# Opção A — SQL Server já existente (produção/legado), isolado em um schema próprio:
#   As tabelas do app ficam em "<schema>.NomeTabela" (ex: investimentos.User), sem
#   tocar nas tabelas legadas do schema "dbo". Requer permissão CREATE SCHEMA no login.
DATABASE_URL="sqlserver://<HOST ou HOST\\INSTANCIA>;database=<NOME_BANCO>;user=<USUARIO>;password=<SENHA>;schema=investimentos;encrypt=true;trustServerCertificate=true"

# Opção B — MSSQL via Docker (docker-compose.yml), dev local isolado:
# SA_PASSWORD=<SA_PASSWORD_FORTE>
# DATABASE_URL="sqlserver://localhost:1433;database=investimentos;user=sa;password=<SA_PASSWORD_FORTE>;schema=dbo;trustServerCertificate=true"

# ==============================
# JWT
# ==============================
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=<ACCESS_SECRET_BASE64_48>
JWT_REFRESH_SECRET=<REFRESH_SECRET_BASE64_48>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================
# App
# ==============================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
