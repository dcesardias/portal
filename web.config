<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- HABILITANDO WEBSOCKET -->
    <webSocket enabled="true" />
    
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    
    <iisnode
      node_env="production"
      nodeProcessCommandLine="node.exe"
      debuggingEnabled="false"
      devErrorsEnabled="true"
      loggingEnabled="true"
      logDirectory="iisnode"
      flushResponse="true"
      enableXFF="true"
      promoteServerVars="LOGON_USER,AUTH_TYPE,AUTH_USER,REMOTE_USER" />
    
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Index.html sempre passa pelo Node (injeção de versão p/ cache-busting) -->
        <rule name="IndexToNode" stopProcessing="true">
          <match url="^(index\.html)?$" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <!-- DynamicContent - encaminha tudo para Node.js (que fará o proxy) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>

        <rule name="Redirect to https" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://intranet.aacd.org.br" appendQueryString="false" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Cache forte para assets estáticos (versionados via ?v=).
         Como o index.html é servido pelo Node com no-cache, mudar a versão
         invalida automaticamente o cache de todos os assets. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
    </staticContent>
    
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
      <!--
        Windows Auth removida do nivel do site pois causava prompt de
        credenciais AD em browsers fora da zona intranet (ex: /homologa).
        Para captura silenciosa de LOGON_USER, e' necessario GPO configurando
        *.aacd.org.br na zona "Local Intranet" — ao fazer isso, basta
        reabilitar windowsAuthentication aqui e reciclar o AppPool.
      -->
    </security>
    
    <httpRedirect enabled="false" destination="https://portaldedados.aacd.org.br/" />
    
    <!-- Configurações para Server-Sent Events (SSE) -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    
    <!-- Desabilitar compressão dinâmica para SSE -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- Repassa o body de erro do Node (JSON) em vez de substituir pela pagina
         de erro padrao do IIS. Sem isso, o IIS troca o JSON {"error":...} por
         HTML default em respostas 4xx/5xx (depende do Accept do request). -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>

  <appSettings>
    <add key="PORT" value="3000" />
  </appSettings>
</configuration>
